#!/bin/bash

# yavaos:summary=Launch the default coding agent with a prompt
# yavaos:args=[--inline] <prompt...>
# yavaos:examples=yavaos agent prompt "Review this project"

# Prompts live here rather than on `yavaos agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: yavaos agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec yavaos-agent "${inline[@]}" --prompt "$*"
