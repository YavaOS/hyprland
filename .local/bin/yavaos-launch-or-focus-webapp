#!/bin/bash

# yavaos:summary=Launch or focus on a given web app identified by the window-pattern.
# yavaos:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: yavaos-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="yavaos-launch-webapp $@"

exec yavaos-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
