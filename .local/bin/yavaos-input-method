#!/bin/bash

# yavaos:summary=Configure, inspect, or switch input methods
# yavaos:args=<status|cycle [back]|configure --seed|--defaults>
# yavaos:hidden=true

set -euo pipefail

if [[ ${1:-} == "cycle" ]]; then
  direction=${2:-next}
  if [[ $direction != "next" && $direction != "back" ]]; then
    echo "Usage: yavaos-input-method cycle [back]" >&2
    exit 1
  fi
  # The shell's reader retains a choice made while nothing has focus.
  if [[ $(yavaos-shell shell cycleInput "$direction") != "ok" ]]; then
    echo "The shell's input reader is not running" >&2
    exit 1
  fi
else
  /usr/bin/python3 "$HOME/.config/yavaos/runtime/input-methods/configure.py" "$@"
fi
