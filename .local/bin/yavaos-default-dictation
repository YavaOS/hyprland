#!/bin/bash

# yavaos:summary=Get or set the default dictation backend
# yavaos:args=[backend]
# yavaos:examples=yavaos default dictation | yavaos default dictation superwhisper

if (($# > 1)); then
  echo "Usage: yavaos default dictation [backend]" >&2
  exit 1
fi

if (($# == 0)); then
  config="${XDG_CONFIG_HOME:-$HOME/.config}/yavaos/defaults/dictation"
  if [[ ! -s $config ]]; then
    echo "No dictation backend configured. Select one in Setup > Defaults > Dictation." >&2
    exit 1
  fi
  read -r backend < "$config"
else
  backend=$1
fi

if [[ ! $backend =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "Invalid dictation backend: $backend" >&2
  exit 1
fi

if (($# == 0)); then
  echo "$backend"
else
  installer="yavaos-install-dictation-$backend"
  if yavaos-cmd-missing "$installer"; then
    echo "No installer available for dictation backend: $backend" >&2
    exit 1
  fi
  yavaos-launch-floating-terminal-with-presentation "$installer"
fi
