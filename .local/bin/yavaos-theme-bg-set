#!/bin/bash

# yavaos:summary=Set the current background image or video
# yavaos:args=<path-to-media>
# yavaos:examples=yavaos theme bg set ~/Pictures/background.png

if [[ -z $1 ]]; then
  echo "Usage: yavaos-theme-bg-set <path-to-media>" >&2
  exit 1
fi

BACKGROUND="$(realpath "$1")"
CURRENT_BACKGROUND_LINK="$HOME/.config/yavaos/current/background"

if [[ ! -f $BACKGROUND ]]; then
  echo "File does not exist: $BACKGROUND" >&2
  exit 1
fi

# Create symlink to the new background media
ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LINK"

# Update the live shell background when it is running. Nothing watches the
# symlink, so this is how the shell learns of the new background.
yavaos-shell -q background set "$BACKGROUND"
