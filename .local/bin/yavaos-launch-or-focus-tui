#!/bin/bash

# yavaos:summary=Launch a TUI or focus an existing terminal window for it
# yavaos:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.yavaos.$(basename "$1")"
fi

LAUNCH_COMMAND="yavaos-launch-tui $@"

exec yavaos-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
