#!/bin/bash

# yavaos:summary=Enable, disable, toggle, or recover mirroring the internal display to an external monitor
# yavaos:args=<on|off|toggle|recover>

TOGGLE="internal-monitor-mirror"
TOGGLE_FLAG="$HOME/.local/state/yavaos/toggles/hypr/$TOGGLE.lua"
DISABLE_TOGGLE="internal-monitor-disable"

INTERNAL=$(yavaos-hyprland-monitor-laptop)
# The first active external monitor
EXTERNAL=$(hyprctl monitors -j | jq -r '.[] | select(.name | test("^(eDP|LVDS|DSI)-") | not).name' | head -n 1)

on() {
  if [[ -z $EXTERNAL ]]; then
    yavaos-notification-send -g 󰍹 "$(yavaos-i18n monitor.noExternalForMirror)"
    exit 1
  fi

  if [[ -z $INTERNAL ]]; then
    yavaos-notification-send -g 󰍹 "$(yavaos-i18n monitor.noLaptopToMirror)"
    exit 1
  fi

  # Both names are written into generated Lua below, so only plain connector
  # names may pass; a user-created headless output can carry any name.
  for output in "$INTERNAL" "$EXTERNAL"; do
    if [[ ! $output =~ ^[A-Za-z0-9._-]+$ ]]; then
      yavaos-notification-send -g 󰍹 "$(yavaos-i18n monitor.unsafeName)"
      exit 1
    fi
  done

  yavaos-hyprland-toggle $DISABLE_TOGGLE off

  if yavaos-hyprland-toggle-disabled $TOGGLE; then
    printf 'hl.monitor({ output = "%s", mode = "preferred", position = "auto", scale = 1, mirror = "%s" })\n' "$EXTERNAL" "$INTERNAL" >"$TOGGLE_FLAG"
    yavaos-notification-send -g 󰍹 "$(yavaos-i18n monitor.mirroringEnabled "$EXTERNAL")"
    hyprctl reload
  fi
}

off() {
  if yavaos-hyprland-toggle-enabled $TOGGLE; then
    yavaos-hyprland-toggle $TOGGLE off
    yavaos-notification-send -g 󰍹 "$(yavaos-i18n monitor.extendedRestored)"
  fi
}

toggle() {
  if yavaos-hyprland-toggle-enabled $TOGGLE; then
    off
  else
    on
  fi
}

recover() {
  if ! yavaos-hyprland-monitor-external-active && yavaos-hyprland-toggle-enabled $TOGGLE; then
    yavaos-hyprland-toggle $TOGGLE off
  fi
}

case "$1" in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
