#!/bin/bash

# yavaos:summary=Show or set the glyph forms for Chinese, Japanese, and Korean text
# yavaos:args=[jp|kr|sc|tc|hk|default]
# yavaos:examples=yavaos font cjk | yavaos font cjk jp | yavaos font cjk default

set -euo pipefail

# Also seeded by the first CJK input method or language chosen. Tagged text and
# a CJK session language keep their own forms regardless.
preference=${XDG_CONFIG_HOME:-$HOME/.config}/fontconfig/conf.d/50-yavaos-input-method.conf

case "${1:-}" in
"")
  variant=""
  if [[ -f $preference ]]; then
    variant=$(sed -n 's|.*<family>Noto Sans CJK \([A-Z]*\)</family>.*|\1|p' "$preference" | head -n 1)
  fi
  variant=${variant,,}
  echo "${variant:-default}"
  ;;
jp | kr | sc | tc | hk | default)
  /usr/bin/python3 "$HOME/.config/yavaos/runtime/input-methods/configure.py" font "$1"
  yavaos-restart-shell
  yavaos-notification-send -g  "$(yavaos-i18n font.cjkChanged)" "$(yavaos-i18n font.restartAppsToSeeChange)"
  ;;
*)
  echo "Usage: yavaos-font-cjk [jp|kr|sc|tc|hk|default]" >&2
  exit 1
  ;;
esac
