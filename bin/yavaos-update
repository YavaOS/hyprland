#!/bin/bash

set -e

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, get help from the community at https://yavaos.org/discord\033[0m"' ERR

if [[ $1 == "-y" ]] || yavaos-update-confirm; then
  yavaos-snapshot create || (($? == 127))
  yavaos-update-git
  yavaos-update-perform
fi
