#!/bin/bash

# Overwrite the user configs for the Walker application launcher (which also powers the YavaOS Menu) and restart the services.

# Ensure walker is set to autostart
mkdir -p ~/.config/autostart/
cp $YAVAOS_PATH/config/walker/walker.desktop ~/.config/autostart/

# And restarts if it crashes or is killed
mkdir -p ~/.config/systemd/user/app-walker@autostart.service.d/
cp $YAVAOS_PATH/config/walker/restart.conf ~/.config/systemd/user/app-walker@autostart.service.d/restart.conf

systemctl --user daemon-reload

# Refresh configs
yavaos-refresh-config walker/config.toml
yavaos-refresh-config elephant/calc.toml
yavaos-refresh-config elephant/desktopapplications.toml

# Restart service
yavaos-restart-walker
