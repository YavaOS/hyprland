#!/bin/bash

# Creates a new YavaOS migration named after the unix timestamp of the last commit.
# Only intended for YavaOS developers.

cd ~/.local/share/yavaos
migration_file="$HOME/.local/share/yavaos/migrations/$(git log -1 --format=%cd --date=unix).sh"
touch $migration_file

if [[ $1 != "--no-edit" ]]; then
  nvim $migration_file
fi

echo $migration_file
