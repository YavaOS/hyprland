#!/bin/bash

# Overwrite the user config for the Plymouth drive decryption and boot sequence with the YavaOS default and rebuild it.

sudo cp ~/.local/share/yavaos/config/plymouth/* /usr/share/plymouth/themes/yavaos/
sudo plymouth-set-default-theme yavaos

if command -v limine-mkinitcpio &>/dev/null; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi
